# ==============================================================================
# AgriSense Monorepo .gitignore
# Covers: Frontend V1, Standalone Frontend V2, Backend Express, FastAPI ML Service
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Dependencies & Package Managers
# ------------------------------------------------------------------------------
node_modules/
**/node_modules/
.pnp/
.pnp.js
jspm_packages/
.pnpm-store/
.npm/
.yarn-integrity
*.tgz

# ------------------------------------------------------------------------------
# 2. Production & Compiler Builds
# ------------------------------------------------------------------------------
.next/
**/.next/
dist/
**/dist/
build/
**/build/
out/
**/out/
.nuxt/
**/.nuxt/
.cache/
**/.cache/
.parcel-cache/
**/.parcel-cache/
.turbo/
**/.turbo/
.vercel/
**/.vercel/
.output/
**/.output/
storybook-static/
.storybook-out/

# PWA Service Worker generated files
**/public/sw.js
**/public/sw.js.map
**/public/workbox-*.js
**/public/workbox-*.js.map
**/public/worker-*.js
**/public/worker-*.js.map

# ------------------------------------------------------------------------------
# 3. Environment & Secrets (Never commit credentials)
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.template
**/.env
**/.env.*
!**/.env.example
!**/.env.template

# ------------------------------------------------------------------------------
# 4. Logs & Process Runtimes
# ------------------------------------------------------------------------------
logs/
**/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
pids/
*.pid
*.seed
*.pid.lock

# ------------------------------------------------------------------------------
# 5. Testing & Code Quality Caches
# ------------------------------------------------------------------------------
coverage/
**/coverage/
*.lcov
.nyc_output/
**/.nyc_output/
playwright-report/
test-results/
.playwright/
.pytest_cache/
**/.pytest_cache/
.hypothesis/
**/.hypothesis/
.mypy_cache/
**/.mypy_cache/
.dmypy.json
dmypy.json
*.tsbuildinfo
.eslintcache
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/
.node_repl_history

# ------------------------------------------------------------------------------
# 6. Uploads, Media & Temporary Artifacts
# ------------------------------------------------------------------------------
uploads/
**/uploads/
!**/uploads/.gitkeep
tmp/
**/tmp/
temp/
**/temp/
*.db
*.sqlite
*.sqlite3

# ------------------------------------------------------------------------------
# 7. Python & ML Virtual Environments
# ------------------------------------------------------------------------------
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
**/env/
venv/
**/venv/
.venv/
**/.venv/
env.bak/
venv.bak/
.ipynb_checkpoints/
**/.ipynb_checkpoints/

# ------------------------------------------------------------------------------
# 8. Machine Learning Model Weights & Large Binaries
# (Models are loaded from external storage or trained via pipelines)
# ------------------------------------------------------------------------------
*.pkl
*.pth
*.pt
*.joblib
*.h5
*.pb
*.onnx
*.bin
models/*
!models/.gitkeep
ml-service/models/*
!ml-service/models/.gitkeep

# ------------------------------------------------------------------------------
# 9. Operating System Artifacts
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Thumbs.db:encryptable
Desktop.ini
$RECYCLE.BIN/

# ------------------------------------------------------------------------------
# 10. Editor & IDE Settings
# ------------------------------------------------------------------------------
.vscode/
**/.vscode/
.idea/
**/.idea/
*.swp
*.swo
*~
.kiro/
.qodo/
.qoder/

# ------------------------------------------------------------------------------
# 11. Agent & Workspace Scratch
# ------------------------------------------------------------------------------
.agents/scratch/
**/scratch/