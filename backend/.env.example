# ============================================================
# ENVIRONMENT VARIABLES REFERENCE
# Copy this file to:
#   .env.development  — for local development
#   .env              — base fallback (gitignored)
# For production (Render), set these directly in the dashboard.
# ============================================================

# --- Database ---
DATABASE_URL=your_database_url_here
# e.g. postgresql://user:pass@host:5432/dbname?pgbouncer=true

# --- Redis ---
REDIS_URL=redis://localhost:6379
DISABLE_REDIS=false

# --- JWT ---
JWT_SECRET=your_strong_jwt_secret_here

# --- Server ---
NODE_ENV=development              # development | production
PORT=5000
API_BASE_URL=http://localhost:5000

# --- Frontend / CORS ---
# Primary frontend URL (used for CORS + email links)
FRONTEND_URL=http://localhost:3000
# production example: FRONTEND_URL=https://agriapp-one.vercel.app

# Extra CORS origins (useful for custom domains in production)
ALLOWED_ORIGIN_1=
# e.g. https://agri-sense.dev
ALLOWED_ORIGIN_2=
# e.g. https://www.agri-sense.dev

# --- ML Service ---
ML_SERVICE_URL=http://localhost:8000

# --- Gemini AI ---
GEMINI_API_KEY=your_gemini_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# --- ChromaDB ---
CHROMA_API_KEY=your_chroma_api_key_here
CHROMA_TENANT=your_chroma_tenant_id
CHROMA_DATABASE=AGRIAPP

# --- Email (Brevo) ---
BREVO_API_KEY=your_brevo_api_key_here
BREVO_FROM_EMAIL=your_sender_email@example.com

# --- File Upload ---
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads
